# MySQL Amazon RDS endpoint (tanpa https://)
DB_HOST=isi-endpoint-rds-anda
DB_PORT=3306
DB_NAME=toko_db
DB_USER=toko_app
DB_PASSWORD=GANTI_DENGAN_PASSWORD_KUAT

# Nomor WhatsApp toko: kode negara + nomor, angka saja. Contoh Indonesia: 6281234567890
WA_NUMBER=6281234567890

# Buat string acak panjang dan sama persis di EC2 A dan EC2 B
APP_KEY=ganti_dengan_random_string_minimal_32_karakter_yang_sama_di_kedua_ec2

# Login halaman admin
ADMIN_USER=admin
ADMIN_PASSWORD=GANTI_DENGAN_PASSWORD_ADMIN_KUAT
